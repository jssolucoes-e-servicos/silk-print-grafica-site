# ==========================================
# SILK PRINT GRÁFICA - CONFIGURAÇÃO DE PRODUÇÃO (.env)
# ==========================================

# GEMINI_API_KEY: Configurado automaticamente via AI Studio Secrets / Cloud Run
GEMINI_API_KEY=""

# APP_URL: URL pública de hospedagem da aplicação
APP_URL=""

# VITE_MAINTENANCE_MODE: Defina "true" para colocar o site em tela de manutenção com orçamento, ou "false" para loja ativa
VITE_MAINTENANCE_MODE="false"

# Dados públicos de atendimento ao cliente (WhatsApp e E-mail exibidos no site)
VITE_WHATSAPP_NUMBER="5511999998888"
VITE_CONTACT_EMAIL="orcamentos@silkprintgrafica.com.br"

# Notificações do Administrador (Para onde os alertas de novos leads são encaminhados)
ADMIN_EMAIL="admin@silkprintgrafica.com.br"
ADMIN_PHONE="5511999998888"

# Webhook do n8n para automação de leads (Evolution WhatsApp, Gmail SMTP, Google Sheets e MongoDB Atlas)
N8N_WEBHOOK_URL="https://main-n8n.qgymrf.easypanel.host/webhook/silkprint-site"

# Evolution API (SmartChat) para disparo de mensagens de WhatsApp via n8n
EVOLUTION_INSTANCE="silkprint"
EVOLUTION_TOKEN="seu-token-evolution-aqui"
