# ==============================================================================
# SILK PRINT GRÁFICA - VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR & AMBIENTE GERAL
# ------------------------------------------------------------------------------
NODE_ENV="development"
TZ="America/Sao_Paulo"
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Configurado automaticamente via AI Studio Secrets / Cloud Run
GEMINI_API_KEY=""

# JWT & SEGURANÇA DO ERP
JWT_SECRET=""
ADMIN_SECRET_PASSWORD="silkprint@admin2026"

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (POSTGRESQL - VPS)
# ------------------------------------------------------------------------------
# Exemplo: postgresql://postgres:senha@qgymrf.easypanel.host:5436/silkprint?schema=public
DATABASE_URL="postgresql://postgres:senha@qgymrf.easypanel.host:5436/silkprint?schema=public"

# ------------------------------------------------------------------------------
# 3. ARMAZENAMENTO DE ARQUIVOS (MINIO S3 - VPS)
# ------------------------------------------------------------------------------
# Armazenamento seguro de artes de clientes, gabaritos e uploads
MINIO_ENDPOINT="minio-server.jssolucoeseservicos.com.br"
MINIO_ACCESS_KEY="smart-platform"
MINIO_SECRET_KEY=""
MINIO_BUCKET_NAME="silkprint-documents"

# ------------------------------------------------------------------------------
# 4. PAGAMENTOS (MERCADO PAGO)
# ------------------------------------------------------------------------------
# Credenciais oficiais do Mercado Pago (PIX Dinâmico + Cartão de Crédito)
MERCADOPAGO_ACCESS_TOKEN=""

# ------------------------------------------------------------------------------
# 5. WHATSAPP & AUTOMAÇÃO (EVOLUTION API / n8n)
# ------------------------------------------------------------------------------
# Automação via n8n para disparo de notificações via Evolution API
N8N_WEBHOOK_URL="https://main-n8n.qgymrf.easypanel.host/webhook/evolution-webhook-proxy"
EVOLUTION_INSTANCE="smartChurches"
EVOLUTION_TOKEN=""

# ------------------------------------------------------------------------------
# 6. E-MAIL TRANSACIONAL & MONITORAMENTO
# ------------------------------------------------------------------------------
# SMTP / Mailer para notificações de pedidos e orçamentos
MAILER_HOST="sandbox.smtp.mailtrap.io"
MAILER_PORT="2525"
MAILER_USER=""
MAILER_PASS=""
MAILER_FROM="no-reply@silkprintgrafica.com.br"
RESEND_API_KEY=""
SENTRY_DSN=""

# ------------------------------------------------------------------------------
# 7. CONTATOS ADMINISTRATIVOS & LOJA
# ------------------------------------------------------------------------------
ADMIN_EMAIL="silkprintgrafica@gmail.com"
ADMIN_PHONE="5551936187210"

# Variáveis públicas acessíveis no frontend (Vite)
VITE_WHATSAPP_NUMBER="5551936187210"
VITE_CONTACT_EMAIL="orcamentos@silkprintgrafica.com.br"
VITE_MAINTENANCE_MODE="false"
VITE_SHOW_MAINTENANCE_FORM="true"
