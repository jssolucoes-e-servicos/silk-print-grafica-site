# ==============================================================================
# SILK PRINT GRÁFICA - BACKEND API (NestJS / Express)
# Arquivo de Variáveis de Ambiente para Easypanel / VPS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR & REDE
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# Origens permitidas para CORS (Loja Virtual, ERP e testes locais)
CORS_ORIGIN=https://silkprint.com.br,https://erp.silkprint.com.br,http://localhost:3000,http://localhost:5173,http://localhost:5174

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (POSTGRESQL - EASYPANEL / VPS)
# ------------------------------------------------------------------------------
# Se estiver no mesmo Easypanel na mesma rede interna: postgresql://postgres:SENHA@silkprint-db:5432/silkprint?schema=public
# Se conectar externamente:
DATABASE_URL=postgresql://postgres:senha@qgymrf.easypanel.host:5436/silkprint?schema=public

# ------------------------------------------------------------------------------
# 3. ARMAZENAMENTO DE ARTES E GABARITOS (MINIO S3)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio-server.jssolucoeseservicos.com.br
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=smart-platform
MINIO_SECRET_KEY=sua_secret_key_aqui
MINIO_BUCKET_NAME=silkprint-documents

# ------------------------------------------------------------------------------
# 4. PAGAMENTOS (MERCADO PAGO - PIX & CARTÃO)
# ------------------------------------------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-seu_token_aqui
MERCADO_PAGO_PUBLIC_KEY=APP_USR-sua_public_key

# ------------------------------------------------------------------------------
# 5. WHATSAPP & AUTOMAÇÕES (EVOLUTION API & n8n)
# ------------------------------------------------------------------------------
EVOLUTION_API_URL=https://api.evolution.exemplo.com
EVOLUTION_API_KEY=sua_chave_evolution
EVOLUTION_INSTANCE=smartChurches
ADMIN_WHATSAPP=5551936187210

# Webhook n8n para orçamentos e cotações personalizadas
N8N_QUOTE_WEBHOOK_URL=https://main-n8n.qgymrf.easypanel.host/webhook/evolution-webhook-proxy

# ------------------------------------------------------------------------------
# 6. SEGURANÇA & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=silkprint_jwt_super_secret_producao_2026
