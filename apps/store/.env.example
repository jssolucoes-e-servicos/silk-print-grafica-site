# ==============================================================================
# SILK PRINT GRÁFICA - LOJA VIRTUAL / STOREFRONT (Next.js 15)
# Arquivo de Variáveis de Ambiente para Vercel
# ==============================================================================

# URL da API Backend NestJS (URL pública cadastrada no Easypanel)
# Exemplo: https://api.silkprint.com.br/api ou https://silkprint-backend.qgymrf.easypanel.host/api
NEXT_PUBLIC_API_URL=https://api.silkprint.com.br/api

# URL do Frontend da Loja
NEXT_PUBLIC_STORE_URL=https://silkprint.com.br

# Contato e Atendimento
NEXT_PUBLIC_WHATSAPP_NUMBER=5551936187210
NEXT_PUBLIC_CONTACT_EMAIL=orcamentos@silkprintgrafica.com.br

# ------------------------------------------------------------------------------
# CONTROLE DE MODO MANUTENÇÃO (TELA DE AGUARDE COM FORMULÁRIO E WHATSAPP)
# ------------------------------------------------------------------------------
# "true"  => Exibe a tela oficial de manutenção da Silk Print para os visitantes
# "false" => Exibe a loja virtual completa normalmente
NEXT_PUBLIC_MAINTENANCE_MODE="true"
NEXT_PUBLIC_SHOW_MAINTENANCE_FORM="true"
