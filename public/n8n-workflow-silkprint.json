    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Lead recebido e distribuído com sucesso!\",\n  \"leadId\": \"{{ $json.body.leadId || $json.body.data.leadId }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "7ec839b2-29b1-4f10-bf9d-f5e9331046bb",
      "name": "Responder 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -380,
        -360
      ]
    },
    {
      "parameters": {
        "fromEmail": "seu-email@gmail.com",
        "toEmail": "={{ $json.body.data.adminEmail || 'admin@silkprintgrafica.com.br' }}",
        "subject": "=🚨 [NOVO ORÇAMENTO] {{ $json.body.data.clientName || $json.body.client.name }} ({{ $json.body.data.channel === 'whatsapp' ? 'WhatsApp' : 'E-mail' }})",
        "html": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; padding: 24px; background: #0f172a; color: #f8fafc; border-radius: 12px;\">\n  <h2 style=\"color: #00a0e9; margin: 0 0 16px;\">SILK PRINT GRÁFICA</h2>\n  <div style=\"background: #1e293b; padding: 16px; border-radius: 8px; margin-bottom: 16px;\">\n    <p style=\"margin: 0 0 8px;\"><strong>👤 Cliente:</strong> {{ $json.body.data.clientName || $json.body.client.name }}</p>\n    <p style=\"margin: 0 0 8px;\"><strong>📱 WhatsApp:</strong> {{ $json.body.data.clientPhone || $json.body.client.phone }}</p>\n    <p style=\"margin: 0 0 8px;\"><strong>✉️ E-mail:</strong> {{ $json.body.data.clientEmail || $json.body.client.email || 'Não informado' }}</p>\n    <p style=\"margin: 0 0 8px;\"><strong>📍 Canal:</strong> {{ $json.body.data.channel }} ({{ $json.body.data.source }})</p>\n    <p style=\"margin: 0;\"><strong>⏰ Data/Hora:</strong> {{ $json.body.data.formattedDate }}</p>\n  </div>\n  <div style=\"background: #1e293b; padding: 16px; border-radius: 8px;\">\n    <h4 style=\"margin: 0 0 8px; color: #38bdf8;\">📝 Descrição do que deseja orçar:</h4>\n    <p style=\"margin: 0; line-height: 1.6; white-space: pre-wrap;\">{{ $json.body.data.description || $json.body.client.description }}</p>\n  </div>\n  <p style=\"font-size: 11px; color: #64748b; margin-top: 16px;\">ID do Lead: {{ $json.body.data.leadId }}</p>\n</div>",
        "options": {}
      },
      "id": "c7118239-e932-4bf1-bda4-1294d1b8027a",
      "name": "Enviar E-mail Gmail (SMTP)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        -380,
        -200
      ],
      "credentials": {
        "smtp": {
          "id": "SEU_CREDENTIAL_ID_GMAIL_SMTP",
          "name": "Gmail SMTP Account"
        }
      }
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.data.messageType }}",
        "rules": {
          "rules": [
            {
              "value2": "TEXT"
